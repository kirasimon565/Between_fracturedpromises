name: Analyze

on:
  push:
    branches: ['**']
  pull_request:
  workflow_dispatch:

jobs:
  analyze:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - uses: subosito/flutter-action@v2
        with:
          channel: 'stable'
          cache: true

      # There is no build_runner step: every model, the Drift schema and the
      # engine are hand-written, so resolving packages is the whole setup.
      - name: Install dependencies
        run: flutter pub get

      - name: Analyze
        run: flutter analyze --no-fatal-infos

      - name: Format check
        run: dart format --output=none --set-exit-if-changed lib/

      # Copy this file to .github/workflows/analyze.yml to enable CI.
      - name: Story + architecture lint
        run: |
          python3 tool/dart_static_check.py
          python3 tool/story_check.py

  build:
    runs-on: ubuntu-latest
    needs: analyze
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-java@v4
        with:
          distribution: 'zulu'
          java-version: '17'

      - uses: subosito/flutter-action@v2
        with:
          channel: 'stable'
          cache: true

      - uses: android-actions/setup-android@v3

      - name: Install dependencies
        run: flutter pub get

      # Unsigned debug APK: proves the Gradle side still assembles now that
      # google-services and the Isar/Firebase hacks are gone.
      - name: Build debug APK
        run: flutter build apk --debug
