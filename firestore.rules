service cloud.firestore {
  match /databases/{database}/documents {
    // Players can only READ episodes
    match /episodes/{episode} {
      allow read: if true;
      allow write: if false; // Only YOU can write via Firebase Console or Admin
    }
    // Players can READ/WRITE their own progress
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
